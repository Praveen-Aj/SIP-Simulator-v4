/*
 * Transport Debug Logger - Unified logging for UDP/TCP/TLS
 */
package sipinspector.Utils;

import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.text.SimpleDateFormat;
import java.util.Date;

/**
 * Centralized transport debug logging (UDP/TCP/TLS)
 * Can be enabled/disabled via system property or programmatically
 * Creates separate log files for each session
 */
public class TLSDebugLogger {

    private static boolean enabled = false;
    private static PrintWriter logWriter = null;
    private static final String LOG_BASE_DIR = "logs";private sta
    ic String currentLogFile = null;
    private static final SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS");
    // Human-readable filename format: "18 Nov 2025 - 09.45.51"
    private static final SimpleDateFormat readableFormat = new SimpleDateFormat("dd MMM yyyy - HH.mm.ss");

    static {
        // Check system property for debug flag
        String debugFlag = System.getProperty("tls.debug");
        if ("true".equalsIgnoreCase(debugFlag)) {
            enable();
        }
    }

    /**
     * Enable debug logging for specified transport
     *
     * @param transport "UDP", "TCP", or "TLS"
     */
    public static synchronized void enable(String transport) {
        if (!enabled) {
            try {
                // Create transport-specific directory
                String transportDir = LOG_BASE_DIR + "/" + transport.toUpperCase();
                File logDir = new File(transportDir);
                if (!logDir.exists()) {
                    logDir.mkdirs();
                }

                // Create session-specific log file with human-readable timestamp
                String timestamp = readableFormat.format(new Date());
                currentLogFile = transportDir + "/" + transport.toUpperCase() + "_Log_" + timestamp + ".log";

                logWriter = new PrintWriter(new FileWriter(currentLogFile, false), true);
                enabled = true;
         

                log("Session started: " + dateFormat.format(new Date()));
                log("Log file: " + currentLogFile);
                log("");

               cleanupOldLogFiles(transportDir, 10);
            } catch (IOException e) {
                // Keep hard errors on stderr; detailed stack can be added later if needed
                System.err.println("Failed to enable debug logging: " + e.getMessage());
            }
        }
    }

    /**
     * Enable TLS debug logging (backward compatibility)
     */
    public static synchronized void enable() {
        enable("TLS");
    }

    /**
     * Disable TLS debug logging
     */

           if (enabled

    log("=== TLS Debug Logging DISABLED ===");
            if (logWriter != null) {
               

    logWriter.close();
                logWriter = null;
            }
            enabled = false;
        }
    }

    /**
     

    eck if logging is 

    enabled    */
    
    public static boolean isEnabled() {
        return enabled;
    }

    /**
     * Log a message (to file only, not console)
     */
    public static synchronized void log(String message) {
        if (enabled && logWriter != null) {
            String timestamp = dateFormat.format(new Date());
            logWriter.println(timestamp + " " + message);
            logWriter.flush();
        }
    }

    /**
     * Log with format (to file only, not console)
     */
    public static void logf(String format, Object... args) {
        if (enabled) {
            log(String.format(format, args));
        }
    }

    /**
     * Log exception (stack trace goes to the log file)
     */
    public static synchronized void logException(String message, Throwable t) {
        if (enabled && logWriter != null) {
            String timestamp = dateFormat.format(new Date());
            logWriter.println(timestamp + " " + message);
            t.printStackTrace(logWriter);
            logWriter.flush();
        }
    }

    /**
     * Get log file path
     */
    public static String getLogFilePath() {
        return currentLogFile;
    }

    /**
     * Clean up old log files, keeping only the most recent N files
     */
    private static void cleanupOldLogFiles(String transportDir, int maxFiles) {
        try {
            File dir = new File(transportDir);
            if (!dir.exists() || !dir.isDirectory()) {
                return;
            }

            File[] logFiles = dir.listFiles((d, name) -> name.endsWith(".log"));
            if (logFiles == null || logFiles.length <= maxFiles) {
                return; // Not exceeding limit
            }

            // Sort by last modified time (oldest first)
            java.util.Arrays.sort(logFiles, (a, b) -> Long.compare(a.lastModified(), b.lastModified()));

            // Delete oldest files to keep only maxFiles
            int filesToDelete = logFiles.length - maxFiles;
            for (int i = 0; i < filesToDelete; i++) {
                // Log deletion into the NEW session log file
                log("Deleted old log file: " + logFiles[i].getName());
                logFiles[i].delete();
            }
        } catch (Exception e) {
            System.err.println("Error cleaning up old log files: " + e.getMessage());
        }
    }
}
